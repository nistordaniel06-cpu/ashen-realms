PORT=8080
# --- Persistență ---
# Producție: DATABASE_URL (PostgreSQL/Supabase). Doar pe SERVER; nu îl pune în client, repo sau loguri.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
DB_SCHEMA=nidraven_game
# SSL: pentru gazde non-locale verifică certificatul implicit. DB_SSL=0 doar pentru medii locale de test.
# DB_POOL=5
# Dezvoltare/teste fără Postgres: SQLite
DB_PATH=nidraven.db
STATIC_FILE=nidraven.html
ALLOWED_ORIGINS=
FOUNDER_ACCOUNT=
FOUNDER_SETUP_CODE=
# Teste PostgreSQL (NU folosi o bază cu date reale; testele creează și șterg o schemă proprie nidraven_t_*):
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
